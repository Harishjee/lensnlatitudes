{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lensnlatitudes",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  // Cloudflare Email Sending — the contact form sends through this binding.
  // The `from` address must use a domain onboarded to Email Sending:
  //   Dashboard → Compute & AI → Email Service → Email Sending → Onboard Domain
  //   (or: npx wrangler email sending enable lensnlatitudes.com)
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@lensnlatitudes.com"]
    }
  ]
}
